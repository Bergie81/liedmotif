{
  "name": "liedmotif",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Thomas Bergmann",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Self-hosted, source-available AI music app (monorepo root).",
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -- concurrently -n web,worker -c blue,green \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "npm run dev -w @liedmotif/web",
    "dev:worker": "npm run dev -w @liedmotif/worker",
    "build": "npm run build -w @liedmotif/web && npm run build -w @liedmotif/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e:harness",
    "test:e2e:full": "npm run test:e2e:harness",
    "test:e2e:harness": "npm run test:e2e:harness -w @liedmotif/web",
    "db:generate": "npm run db:generate -w @liedmotif/db",
    "db:migrate": "dotenv -- npm run db:migrate -w @liedmotif/db",
    "db:seed": "dotenv -- npm run db:seed -w @liedmotif/db",
    "icons:generate": "tsx scripts/generate-icons.mts",
    "docs:sync": "tsx scripts/sync-docs.mts",
    "assistant:eval": "dotenv -- tsx --tsconfig apps/web/tsconfig.json scripts/assistant-eval.mts",
    "onboarding:demo": "bash scripts/onboarding-demo.sh",
    "onboarding:state": "dotenv -- tsx scripts/onboarding-state.mts",
    "db:studio": "dotenv -- npm run db:studio -w @liedmotif/db",
    "db:migrate:worker": "dotenv -- npm run migrate -w @liedmotif/worker",
    "auth:generate": "npm run auth:generate -w @liedmotif/db",
    "db:test:up": "docker compose --profile test up -d postgres-test",
    "db:test:down": "docker compose --profile test rm -sf postgres-test",
    "s3:test:up": "docker compose --profile test up -d s3-test",
    "s3:test:down": "docker compose --profile test rm -sf s3-test",
    "mail:test:up": "docker compose --profile test up -d mailpit-test",
    "mail:test:down": "docker compose --profile test rm -sf mailpit-test",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "backup:restore": "dotenv -- node scripts/backup-restore.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "next": {
      "postcss": "^8.5.25",
      "sharp": "^0.35.4"
    },
    "drizzle-kit": {
      "esbuild": "^0.28.1"
    },
    "tsup": {
      "esbuild": "^0.28.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.1"
    }
  }
}
