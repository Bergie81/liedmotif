# Liedmotif environment configuration.
# Copy to `.env`, replace placeholders, and never commit the resulting file.

# --- App --------------------------------------------------------------------
# The ONE origin the instance is reached at, exactly: scheme, host, and port.
# Sign-in and every write compare the browser's Origin against it, so a second
# hostname for the same instance (LAN IP *and* domain) is refused, not accepted.
APP_PUBLIC_URL=http://localhost:2206
# Plain http on a non-local host issues session cookies without the Secure flag,
# so a production boot refuses it. Set this to 1 only on a trusted network where
# that is the deliberate choice; the boot then warns instead of failing.
#ALLOW_INSECURE_PUBLIC_URL=1
# Direct (non-Caddy) web port for the Docker stack, bound to loopback.
# Dev/prod split on one machine: give each checkout its own `.env` with a unique COMPOSE_PROJECT_NAME and non-overlapping ports. A production clone
# typically takes 80/443 (Caddy) + 2207 (web); a dev checkout moves its own stack to e.g. web 2216 and Caddy 127.0.0.1:8080 and 127.0.0.1:8443 so `next dev` (2206) and production never collide with it. See docker/README.md.
WEB_PORT=2206

# Generate real values with `openssl rand -base64 32`.
APP_SECRET=change-me-app-secret-please-generate-a-real-one
# Falls back to APP_SECRET when blank.
BETTER_AUTH_SECRET=change-me-better-auth-secret-please-generate-a-real-one
# Base64-encoded 32-byte AES key. Rotation invalidates stored credentials.
CREDENTIAL_ENCRYPTION_KEY=change-me-base64-32-byte-key-please-generate-real

# First-run setup authority. Leave unset on a trusted LAN: the setup wizard is
# then open to whoever reaches it first, which is fine when only you can.
# Set it BEFORE exposing the instance to the internet, where a scanner can
# otherwise claim the administrator account before you finish the wizard, then
# open the wizard as https://<host>/setup?token=<value>. Generate one with
# `openssl rand -hex 32`. Once the administrator exists the token grants
# nothing; remove it after setup.
#SETUP_TOKEN=

# How many proxies sit in front of the app. Rate limiting keys on the client
# address the outermost trusted one forwarded, so this count must match the real
# chain: 1 for the shipped stack (Caddy alone), 2 behind a cloud load balancer
# (client -> LB -> Caddy, and set `trusted_proxies` in the Caddyfile too), 0 when
# nothing fronts the app. Too low and every client shares the proxy's bucket —
# ten failed logins lock out everyone; too high and the caller picks their own
# bucket. Blank defaults to 1.
#TRUSTED_PROXY_HOPS=1

# Docker HTTPS settings. Caddy issues an internal-CA certificate for
# APP_DOMAIN; a LAN IP works too (install Caddy's root cert on clients).
APP_DOMAIN=localhost
# Unset: only this machine can reach Caddy. Set plain ports (80, 443) to serve a
# domain or anything other devices must reach, and set SETUP_TOKEN first when the
# internet can reach it: whoever opens /setup first becomes the Admin. To move
# Caddy but keep it private: 127.0.0.1:8080.
#CADDY_HTTP_PORT=80
#CADDY_HTTPS_PORT=443
# Which Liedmotif images the Docker stack runs. `local` is never published:
# `npm run docker:up` builds it from this checkout. A release version such as
# `1.2.0` (git tag `v1.2.0`) runs that release's published images
# (`docker compose pull`, then `docker compose up -d --no-build`); the installer
# moves it on every update.
LIEDMOTIF_VERSION=local
# Compose project name; namespaces containers/volumes/networks per checkout.
# Uncomment (with a unique name) when running two instances on one machine.
#COMPOSE_PROJECT_NAME=liedmotif-prod

# Container resource ceilings, shown at their `docker-compose.yml` defaults
# (that file is authoritative). They suit a host with a few GB of RAM to spare;
# raise them if a legitimate workload is being OOM-killed, and lower them on a
# small VPS.
#WEB_MEM_LIMIT=2g
#WEB_PIDS_LIMIT=256
#WORKER_MEM_LIMIT=2g
#WORKER_PIDS_LIMIT=512
#MIGRATE_MEM_LIMIT=512m
#MIGRATE_PIDS_LIMIT=128
#CADDY_MEM_LIMIT=512m
#CADDY_PIDS_LIMIT=256
#POSTGRES_PIDS_LIMIT=512

# `web` and `worker` run on a read-only root filesystem; `/tmp` is a tmpfs of
# this size and is the only writable path outside the `/data` volume. Its pages
# count against the memory limit above, so raise both together. The worker
# stages the audio it analyses there — below roughly 300m it starts refusing
# large tracks with a retryable "not enough temp-disk headroom".
#WEB_TMPFS_SIZE=64m
#WORKER_TMPFS_SIZE=512m

# Graceful shutdown for the web container. On SIGTERM (every deploy) the web
# process keeps serving in-flight audio streams and zip downloads for this many
# milliseconds before closing the pool and exiting, so playback isn't cut
# mid-byte. WEB_STOP_GRACE_PERIOD is the compose stop-grace Docker waits before
# SIGKILL — keep it above WEB_SHUTDOWN_GRACE_MS plus a few seconds of pool-close
# headroom, and raise both together.
#WEB_SHUTDOWN_GRACE_MS=15000
#WEB_STOP_GRACE_PERIOD=25s

# --- Database ---------------------------------------------------------------
# Host development only. Docker uses its internal Postgres by default.
# Keep the app and test databases separate; tests reset the test database.
# A database on a public host must carry a verifying TLS mode
# (`?sslmode=verify-full`, or `verify-ca` where the hostname cannot be verified)
# — the boot refuses a plaintext connection to one. A LAN or VPC address warns
# instead; loopback and a compose service name are silent. The compose default
# password (`liedmotif`) is published in this repository: set POSTGRES_PASSWORD
# and the matching password here before exposing the instance.
DATABASE_URL=postgres://liedmotif:liedmotif@localhost:5433/liedmotif_dev
TEST_DATABASE_URL=postgres://liedmotif:liedmotif@localhost:5433/liedmotif_test
TEST_POSTGRES_DB=liedmotif_test
TEST_DB_PORT=5433

# Connection-pool sizing and per-session timeouts, shown at their defaults.
# Raise the pool sizes only alongside the connection cap of a managed Postgres —
# web + worker + migrations all draw on the same instance. The timeouts are in
# milliseconds; 0 sets nothing and leaves that ceiling to the database's own
# configuration. The worker's are deliberately generous because its jobs are
# (downloads bounded at 120s, analysis longer), while the web values keep one
# runaway query from holding a connection through every request that follows.
# Migrations and seeds run untimed.
#WEB_DB_POOL_MAX=10
#WEB_DB_STATEMENT_TIMEOUT_MS=30000
#WEB_DB_LOCK_TIMEOUT_MS=10000
#WEB_DB_IDLE_TX_TIMEOUT_MS=60000
#WORKER_DB_POOL_MAX=8
#WORKER_DB_STATEMENT_TIMEOUT_MS=300000
#WORKER_DB_LOCK_TIMEOUT_MS=30000
#WORKER_DB_IDLE_TX_TIMEOUT_MS=300000

# --- Backups ----------------------------------------------------------------
# The `backup` service runs from `docker compose up` with no further action. The
# schedule, keep count and "Include music & covers" are set in Settings → Backups
# (Admin), not here; see https://liedmotif.com/docs/backups/.
#
# Set a passphrase and the database dumps are encrypted (AES-256, PBKDF2), and
# Settings → Backups can offer downloads, which are always encrypted with it.
# Leave it blank and dumps are written in the clear, which the service warns
# about on every start, and Download stays off. Media snapshots are plain files
# either way. Keep the passphrase OUT of any copy of the backups — and note that
# restoring is only half the job: stored provider credentials decrypt with
# CREDENTIAL_ENCRYPTION_KEY above, which must be backed up separately, under
# stricter access.
#BACKUP_ENCRYPTION_PASSPHRASE=
# How long a FAILED backup waits before retrying, doubling up to a day. The
# database is unreachable for a few seconds on every deploy; without this a blip
# would cost a whole period with no fresh backup.
#BACKUP_RETRY_SECONDS=300
# A backup is refused while the backups volume has less than this free (2 GiB):
# backups share a disk with Postgres, and a full disk takes Postgres down.
#BACKUP_MIN_FREE_BYTES=2147483648
#BACKUP_MEM_LIMIT=256m
#BACKUP_PIDS_LIMIT=128

# --- Storage ----------------------------------------------------------------
# Host path. Docker always uses its mounted `/data` volume.
# Important: Use absolute path to this repo (/home/<USER>/.../liedmotif)
# The boot refuses a relative path — it would resolve against each process's own
# working directory, so the worker's deletes would silently miss the tree the web
# process wrote — and refuses a directory that is missing or not writable by the
# user the app runs as. Create it before first start (`mkdir -p`).
DATA_DIR=

# Storage backend: `local-fs` (default) or `s3` (any S3-compatible service —
# AWS, Cloudflare R2, Backblaze B2, Hetzner Object Storage, self-hosted MinIO).
# Blank counts as unset. See https://liedmotif.com/docs/email-and-storage/.
STORAGE_PROVIDER=
# Required when STORAGE_PROVIDER=s3 (the app refuses to boot without them).
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endpoint URL of the S3-compatible service; leave blank for AWS itself.
S3_ENDPOINT=
# true for MinIO and other providers that need path-style addressing.
S3_FORCE_PATH_STYLE=
# Optional key prefix for sharing a bucket with other data, e.g. `liedmotif`.
S3_KEY_PREFIX=

# S3 adapter contract tests run against a local S3 server (`npm run s3:test:up`);
# with TEST_S3_ENDPOINT blank that test leg skips visibly.
TEST_S3_ENDPOINT=http://127.0.0.1:9400
TEST_S3_PORT=9400

# --- Account email ----------------------------------------------------------
# Optional. Set BOTH to have the app mail invites and password-reset links;
# leave both blank and every link stays copy-and-hand-over. Exactly one set
# fails the boot. SMTP_URL holds the mail account's password and is never
# logged. `smtps://` is TLS from the first byte (port 465); `smtp://` upgrades
# with STARTTLS when the server offers it. Gmail example (an app password,
# URL-encoded): smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
# The sender every mail carries, e.g. `Liedmotif <you@example.com>`.
MAIL_FROM=
# Local development: point them at Mailpit (`npm run mail:test:up`, inbox at
# http://127.0.0.1:8025), so no mail leaves the machine:
#SMTP_URL=smtp://localhost:1025
#MAIL_FROM=Liedmotif <liedmotif@localhost>

# SMTP adapter contract tests send through the same Mailpit and read the mail
# back over its HTTP API; with either blank that test leg skips visibly.
TEST_SMTP_URL=smtp://127.0.0.1:1025
TEST_MAILPIT_URL=http://127.0.0.1:8025
TEST_SMTP_PORT=1025
TEST_MAILPIT_PORT=8025

# --- Instance alerts ---------------------------------------------------------
# Optional. ALERT_CHECK_TOKEN arms the feature; without it GET /api/alerts/check
# answers 404 and nothing is sent, whatever else is set here. Generate one with
# `openssl rand -hex 32`. Alerts go to the webhook, to account email (the Admin's
# Confirmed email), or to both. A token with neither, or a webhook with no token,
# fails the boot. The URL may point at a receiver on your LAN over plain http,
# and is never logged. Scheduling is the host's job: see
# https://liedmotif.com/docs/alerts/ for the cron line.
#ALERT_CHECK_TOKEN=
#ALERT_WEBHOOK_URL=

# --- Music provider ---------------------------------------------------------
# Provider-returned media (stream and final audio, cover images) is fetched over
# https only: those bytes become a stored track, so on plain http a network MITM
# picks them. Set this to 1 only for a self-hosted provider on a network you
# trust that cannot serve TLS. The private/metadata-host block still applies.
#ALLOW_INSECURE_PROVIDER_MEDIA=1
# `mock` needs no key. `suno` needs one: set SUNO_API_KEY here, or leave it
# blank and enter the key in onboarding (Settings → Providers). A value here wins.
MUSIC_PROVIDER=suno
SUNO_API_KEY=
#SUNO_BASE_URL=https://api.sunoapi.org
SUNO_MODEL=V5
# "Use my voice" (record and sing with your own voice) is off unless
# this is `true`: the provider's voice clone does not sound good enough yet.
# `true` offers Settings → My voice and the Own Voice controls. Off, own-voice
# requests are refused, and More Like This / Change Vibe from an own-voice Track
# or Session continue with the generic singer.
OWN_VOICE_ENABLED=

# --- Text LLM ---------------------------------------------------------------
# Optional. Set it up in onboarding or Settings → Providers. Lines set here win
# over the app and lock its text-LLM settings, so leave them commented unless
# you want the text LLM configured in this file instead.
# Presets: openai | gemini | ollama | openrouter | openai-compatible.
# Structured controls do not use the text LLM.
#LLM_PROVIDER=openrouter
#LLM_API_KEY=

# Required for custom compatible providers. Ollama: http://host.docker.internal:11434
# under Docker Compose, http://localhost:11434 (the default) when run natively.
#LLM_BASE_URL=
#LLM_MODEL=minimax/minimax-m3
# OpenAI (gpt-6-luna) and Gemini (gemini-3.8-flash) have a default model; other presets require one.
# Optional: none | minimal | low | medium | high | xhigh | max. Which values a model accepts is model-dependent (e.g.GPT-5.6 has no `minimal`); the openai preset defaults to high with its default model, gemini defaults to low and sends minimal for none (Gemini cannot turn thinking off), the others send it only when set. For an Ollama thinking model, `none` turns thinking off.
# The Assistant ignores this on the openai preset and always asks with `none`: OpenAI refuses tool calls sent with any other effort.
#LLM_REASONING_EFFORT=
# true only if the provider+model support OpenAI strict structured outputs (`response_format: json_schema`) — e.g. current OpenAI models. Keep false for Ollama: schema-constrained decoding can stall a local model past the timeout.
# false is the safe default: any model works via JSON-in-text parsing. A wrong true breaks every expansion; a wrong false only costs a little reliability.
# true | false
#LLM_SUPPORTS_STRUCTURED_OUTPUTS=false
#LLM_REQUEST_TIMEOUT_MS=120000 # Blank defaults to 30000 ms.

# Gemini instead (key from https://aistudio.google.com/apikey) — use these LLM_* values instead:
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_MODEL=                                       # blank uses gemini-3.8-flash

# Local Ollama on the same machine instead (keyless) — use these LLM_* values instead:
# LLM_PROVIDER=ollama
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434              # Liedmotif run natively (npm run dev / start)
# LLM_BASE_URL=http://host.docker.internal:11434   # Liedmotif in Docker Compose
# LLM_MODEL=llama3.1                               # any model from `ollama list`
# LLM_REASONING_EFFORT=none                        # thinking models only (Qwen 3, DeepSeek R1, …)
# LLM_SUPPORTS_STRUCTURED_OUTPUTS=false

# --- Generated cover art ----------------------------------------------------
# Optional. Enter the image key in onboarding or Settings → Providers. A key set
# here (IMAGE_API_KEY, with IMAGE_PROVIDER naming its provider) wins over the app
# and locks its key field, so leave these commented unless you want the key in
# this file instead. IMAGE_PROVIDER is `openai`, `gemini` or `openrouter`.
# Gemini Covers need billing turned on at Google.
# Shared key: with no image key of its own (IMAGE_API_KEY blank, none saved in
# the app), Cover images use the text LLM's key when LLM_PROVIDER (or the Text
# AI saved in the app) names the same vendor and runs without LLM_BASE_URL. So
# IMAGE_PROVIDER=openai with a blank IMAGE_API_KEY uses LLM_API_KEY beside
# LLM_PROVIDER=openai. A different vendor needs its own IMAGE_API_KEY.
#IMAGE_PROVIDER=openai
#IMAGE_API_KEY=

# Usually no override is needed. They also apply to a key saved in the app.
# IMAGE_MODEL, when set, wins over the model entered in onboarding or Settings
# and locks that field. Blank uses the provider's default: gpt-image-2.6-flare
# on `openai`, gemini-nano-banana-2.1 on `gemini`, google/gemini-3.1-flash-image
# on `openrouter`.
#IMAGE_MODEL=
# Blank defaults to 60000 ms.
#IMAGE_REQUEST_TIMEOUT_MS=

# OpenRouter only (`openai` and `gemini` always paint one square image, 1024px
# and 1K).
# Defaults shown. IMAGE_SUPPORTED_PARAMS lists the request parameters to assume
# while OpenRouter's model listing is unreachable, for example
# `aspect_ratio,input_references`.
#IMAGE_RESOLUTION=1K
#IMAGE_ASPECT_RATIO=1:1
#IMAGE_SUPPORTED_PARAMS=

# --- Runtime ----------------------------------------------------------------
LOG_LEVEL=info
# Blank defaults to 2; allowed range is 1–16.
WORKER_CONCURRENCY=
